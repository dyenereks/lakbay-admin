# Copy to .env.local and fill in. Never commit real values (.env* is gitignored).

# ---------------------------------------------------------------------------
# The public site this admin manages
# ---------------------------------------------------------------------------
# Where "View site" and package preview links point, where relative package
# image paths resolve, and where revalidation requests are sent.
# Defaults to the production domain when unset.
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3121

# Shared secret for the public site's /api/revalidate endpoint. Must match the
# REVALIDATE_SECRET set on the public site, or saved changes won't appear there
# until its next deploy. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Firebase — browser SDK (safe to expose; these ship in the client bundle).
# Firebase console > Project settings > General > Your apps > Web app.
# Same Firebase project as the public site.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
# Firebase console > Project settings > Service accounts > Generate new private key.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key on ONE line, keeping the literal \n sequences, wrapped in quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# On Netlify/Vercel, paste the value WITHOUT surrounding quotes — those dashboards
# store it verbatim and literal quotes end up inside the key, which makes Firebase
# reject the service account ("Failed to parse private key").
FIREBASE_PRIVATE_KEY=
# Usually <project-id>.firebasestorage.app — falls back to the NEXT_PUBLIC_ one.
FIREBASE_STORAGE_BUCKET=

# Comma-separated emails allowed to sign in. Strongly recommended.
# When empty, ANY account in the Firebase project can sign in.
ADMIN_EMAILS=
