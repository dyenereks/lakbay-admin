rules_version = '2';

// All writes go through the Next.js server using the Firebase Admin SDK, which
// bypasses these rules entirely. Browsers therefore get read-only access, and
// there is no path for a client to write package data directly.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public marketing content — anyone may read.
    match /packages/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Site settings are only ever read server-side through the Admin SDK, so
    // browsers need no access at all.
    match /settings/{document} {
      allow read, write: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
